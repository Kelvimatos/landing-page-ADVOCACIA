# ==============================================================================
# MARCUS SAYEG ADVOCACIA — REPOSITORY SECURITY & IGNORE RULES (.gitignore)
# ==============================================================================

# Environment files and credentials
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
secrets/
credentials.json

# Local testing, debugging and headless profiles
.chrome*
.chrome-test/
.chrome-debug/
.chrome-temp/
scratch/
test-results/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor & IDE configurations
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Node dependencies (if initialized in the future)
node_modules/
package-lock.json

# Backup files
*.bak
*.orig
*~
